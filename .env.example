APP_NAME=FORMIVA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ─────────────────────────────────────────────────────────────
# Database — MySQL 8 is the intended production connection.
# For local development without MySQL, you may set:
#   DB_CONNECTION=sqlite
#   DB_DATABASE=database/database.sqlite
# ─────────────────────────────────────────────────────────────

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ─────────────────────────────────────────────────────────────
# FORMIVA — application settings (see config/formiva.php)
# ─────────────────────────────────────────────────────────────

# Where the public site reads its content from.
#   database — the CMS tables, edited from /admin  (the default)
#   static   — resources/content/*.php, the files in the repository
#
# Both return identical shapes; ContentParityTest holds them to it. `database`
# needs `php artisan migrate --seed` to have run at least once — the seeder
# imports the files into the tables. Until then the singleton values fall back
# to the files anyway, so the site renders either way.
#
# Set this to `static` only to take the CMS out of the loop deliberately.
FORMIVA_CONTENT=database

# Optional. Caches the resolved content for the TTL below; the workspace
# invalidates it on every save, so an edit is visible immediately.
# FORMIVA_CONTENT_CACHE=true
# FORMIVA_CONTENT_CACHE_TTL=3600

# Optional. The password given to the seeded admin@formiva.test and
# editor@formiva.test accounts in local development. Leave it unset and the
# seeder generates one and prints it once. Never set in production — the
# seeder refuses to create those accounts there at all.
# FORMIVA_SEED_PASSWORD=

# ─────────────────────────────────────────────────────────────
# Sessions, cache and queues remain filesystem/sync by default
# so the public site runs without extra infrastructure.
# ─────────────────────────────────────────────────────────────

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync

VITE_APP_NAME="${APP_NAME}"
