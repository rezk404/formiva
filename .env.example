APP_NAME=FORMIVA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ─────────────────────────────────────────────────────────────
# This phase is frontend-only. No database, queue or mail driver
# is required to serve the site. Everything below stays on the
# filesystem so the project runs with nothing else installed.
# ─────────────────────────────────────────────────────────────

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync

VITE_APP_NAME="${APP_NAME}"
