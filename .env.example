APP_NAME=FORMIVA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ─────────────────────────────────────────────────────────────
# Database — MySQL 8 is the intended production connection.
# For local development without MySQL, you may set:
#   DB_CONNECTION=sqlite
#   DB_DATABASE=database/database.sqlite
# ─────────────────────────────────────────────────────────────

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ─────────────────────────────────────────────────────────────
# FORMIVA — application settings (see config/formiva.php)
# ─────────────────────────────────────────────────────────────

FORMIVA_CONTENT=static

# ─────────────────────────────────────────────────────────────
# Sessions, cache and queues remain filesystem/sync by default
# so the public site runs without extra infrastructure.
# ─────────────────────────────────────────────────────────────

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync

VITE_APP_NAME="${APP_NAME}"
